<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Land Sales Purchases</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Arial', sans-serif;
    }

    body {
      background: #ffffff;
      color: #333;
    }

    /* Top Navbar */
    header {
      background: #1a1a1a;
      color: white;
      padding: 15px 50px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    header nav a {
      color: white;
      text-decoration: none;
      margin: 0 15px;
      font-size: 14px;
    }

    header nav a:hover {
      color: #f2a900;
    }

    /* Main Section */
    .container {
      display: flex;
      max-width: 1200px;
      margin: 50px auto;
      padding: 0 30px;
      gap: 50px;
      align-items: center;
    }

    .left {
      flex: 1;
    }

    .left h1 {
      font-size: 48px;
      font-weight: 900;
      line-height: 1.2;
      margin-bottom: 20px;
    }

    .left p {
      font-size: 16px;
      color: #666;
      margin-bottom: 30px;
    }

    .btn {
      background: #f2a900;
      color: #000;
      padding: 12px 30px;
      border: none;
      font-weight: bold;
      cursor: pointer;
      font-size: 16px;
      border-radius: 3px;
    }

    .btn:hover {
      background: #ffbb33;
    }

    .features {
      display: flex;
      gap: 20px;
      margin-top: 40px;
      font-size: 14px;
      flex-wrap: wrap;
    }

    .features div {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Right Side Card */
    .right {
      flex: 1;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 10px;
      padding: 40px;
      color: white;
      text-align: center;
    }

    .right h2 {
      font-size: 36px;
      margin-bottom: 20px;
    }

    .play-btn {
      background: white;
      color: #333;
      padding: 10px 40px;
      border: none;
      border-radius: 5px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 20px;
    }

    /* Yellow Banner */
    .banner {
      background: #f2a900;
      padding: 20px 50px;
      display: flex;
      align-items: center;
      gap: 20px;
      margin-top: 50px;
    }

    .banner img {
      width: 80px;
      height: 80px;
      object-fit: cover;
    }

    @media (max-width: 768px) {
      .container {
        flex-direction: column;
        text-align: center;
      }
      header {
        padding: 15px 20px;
        flex-direction: column;
        gap: 10px;
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div><strong>LSP</strong></div>
    <nav>
      <a href="#">HOME</a>
      <a href="#">LAND FOR SALE</a>
      <a href="#">PURCHASE</a>
      <a href="#">CONTACT</a>
    </nav>
  </header>

  <!-- Main Content -->
  <div class="container">
    <div class="left">
      <h1>Land Sales<br>Purchases</h1>
      <p>Find and sell land easily. Trusted service for buyers and sellers.</p>
      <button class="btn">Browse Lands</button>
      
      <div class="features">
        <div>✓ Verified Lands</div>
        <div>✓ Best Price</div>
        <div>✓ Fast Process</div>
        <div>✓ Legal Support</div>
      </div>

    <div class="right">
      <h2>Available Lands</h2>
      <p>Check the latest land listings here</p>
      <button class="play-btn">VIEW</button>
    </div>
  </div>

  <!-- Yellow Banner -->
  <div class="banner">
    <img src="https://via.placeholder.com/80" alt="Land">
    <div>
      <strong>New Lands Available</strong><br>
      Check out the latest land for sale in your area!
    </div>
  </div>
</body> 
</html> 
!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Portfolio</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 50px;
      background: #0d1117;
      color: white;
    }
    h1 { color: #58a6ff; }
  </style>
</head>
<body>
  <h1>Hello, I'm Lakshan</h1>
  <p>Welcome to my portfolio website 🚀</p>
</body>
</html>
